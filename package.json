{
  "name": "playwright_js",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "pretest": "node -e \"['test-results/allure-results','test-results/traces', 'test-results/videos'].forEach(d=>require('fs-extra').emptyDirSync(d))\"",
    "test": "cucumber-js --exit",
    "test:prod": "cross-env ENV=prod npm test",
    "test:stage": "cross-env ENV=stage npm test",
    "test:prod:headless": "cross-env ENV=prod HEAD=true npm test",
    "test:staging:headless": "cross-env ENV=stage HEAD=true npm test",
    "smoke:prod": "cross-env ENV=prod npm test -- --tags \"@smoke\"",
    "smoke:stage": "cross-env ENV=stage npm test -- --tags \"@smoke\"",
    "reg:prod": "cross-env ENV=prod npm test -- --tags \"@reg\"",
    "reg:stage": "cross-env ENV=stage npm test -- --tags \"@reg\"",
    "allure-generate": "allure generate test-results/allure-results --clean -o test-results/allure-report",
    "allure-open": "allure open test-results/allure-report"
  },
  "keywords": [
    "playwright-cucumber",
    "cucumber-javascript"
  ],
  "author": "Sonali Acharyya",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.42.0",
    "allure-cucumberjs": "^3.9.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.5",
    "multiple-cucumber-html-reporter": "^3.10.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "winston": "^3.19.0"
  }
}
